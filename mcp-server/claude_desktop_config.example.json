{
  "mcpServers": {
    "recipe-manager": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mhylle.com/mcp/recipe-manager",
        "--header",
        "X-MCP-Token:YOUR_TOKEN_HERE"
      ]
    },
    "recipe-manager-local": {
      "command": "node",
      "args": ["/absolute/path/to/recipe-manager/mcp-server/index.js"],
      "env": {
        "RECIPE_MANAGER_API_URL": "http://localhost:3000/api",
        "RECIPE_MANAGER_LOCALE": "da"
      }
    }
  }
}
