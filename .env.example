# Local development
RECIPE_MANAGER_DB_PASSWORD=devpassword
DB_HOST=postgres
BACKEND_PORT=8006
FRONTEND_PORT=3007
CORS_ORIGIN=http://localhost:4200

# Web Push — lets cooking timers ring on a phone with the app closed.
# Optional: absent keys mean timers ring only while the page is open.
# Generate a pair with: npx web-push generate-vapid-keys
# Note push needs a service worker, which is disabled in `ng serve`, so testing
# this locally requires a production build.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@localhost

# Production (set in GitHub Secrets)
# BACKEND_IMAGE=ghcr.io/mhylle/recipe-manager-backend:latest
# FRONTEND_IMAGE=ghcr.io/mhylle/recipe-manager-frontend:latest
# RECIPE_MANAGER_DB_PASSWORD=<secret>
