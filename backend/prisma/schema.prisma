generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Unit {
  g
  kg
  ml
  l
  tsp
  tbsp
  piece
  pinch
}

enum PantryCategory {
  dairy
  meat
  produce
  grains
  spices
  condiments
  baking
  frozen
  canned
  beverages
  snacks
  other
}

/// What someone is telling us about.
enum ReportKind {
  defect
  improvement
}

enum Difficulty {
  easy
  medium
  hard
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

/// A local mirror of an mhylle.com identity.
///
/// Keyed on the JWT `sub`, never on email: an address can change and a subject
/// cannot, so keying on email would strand a user's pantry the day they change
/// it. `email` and `displayName` are a display cache — the auth-service stays
/// authoritative and refreshes them on every authenticated request.
model User {
  id          String   @id @default(uuid())
  ssoSubject  String   @unique
  email       String
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Last known answer to "may this person write to the shared library?".
  ///
  /// A CACHE of the auth-service's `apps` grant, refreshed on every authenticated
  /// JWT request. The token stays authoritative for anything carrying one — this
  /// column exists for callers that have no token at all, namely an MCP API key,
  /// which cannot consult the auth-service.
  ///
  /// Consequence worth knowing: a grant revoked in the auth-service keeps working
  /// over MCP until that person next signs in through the browser. Acceptable for
  /// a household cookbook; it would not be for anything larger.
  canContribute      Boolean  @default(false)

  /// Contribution granted HERE, by the app owner, from the admin page.
  ///
  /// Separate from `canContribute` because that one is overwritten from the token
  /// on every sign-in — a local grant stored there would be wiped by the user's
  /// next login. The two are OR-ed: a grant from either source is enough.
  ///
  /// Exists because granting through the auth-service takes effect only when the
  /// person next signs in, and later still for their MCP key. An owner clicking
  /// "allow" and seeing nothing change for a day is a worse answer than a second
  /// source of truth.
  localContributor   Boolean  @default(false)

  /// The user's Gemini API key, encrypted IN THE BROWSER.
  ///
  /// An opaque envelope — JSON holding a version, a PBKDF2 salt, an AES-GCM
  /// nonce and the ciphertext — produced and consumed only by the client, using
  /// a passphrase the server never sees. Stored and returned verbatim; the
  /// backend cannot decrypt it and must never try.
  ///
  /// One TEXT column rather than a column per crypto parameter, so changing the
  /// KDF or cipher is a version bump inside the envelope instead of a migration.
  ///
  /// Nullable because most people will not set one. There is no shared fallback
  /// key by design, so a null here means "this cook uploads their own photos".
  geminiKeyEnvelope  String?
  /// Shown on the profile page so a stale key is recognisable as stale.
  geminiKeyUpdatedAt DateTime?

  ownedPantries     Pantry[]       @relation("PantryOwner")
  pantryMemberships PantryMember[]
  createdRecipes    Recipe[]
  pushSubscriptions PushSubscription[]
  scheduledTimers   ScheduledTimer[]
  mcpApiKeys        McpApiKey[]
  reports           Report[]

  @@index([email])
}

/// Something a cook reported: a fault, or a wish.
///
/// The row is the record, and GitHub is a mirror of it. Saving happens first and
/// unconditionally: an unreachable API, a missing token or a rate limit must
/// never lose somebody's bug report, and the whole point of the button is that
/// reporting is frictionless enough to actually get used.
model Report {
  id          String     @id @default(uuid())
  kind        ReportKind
  title       String
  description String
  /// Who reported it. RESTRICT, not cascade — deleting a person must not erase
  /// the defects they found, which may still be open.
  reporterId  String
  reporter    User       @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  /// What the client was looking at. Saves a round trip of "where were you?".
  pagePath    String?
  createdAt   DateTime   @default(now())

  /// Mirror state. Null issue number means "not on GitHub", for any reason.
  githubIssueNumber Int?
  githubIssueUrl    String?
  githubSyncedAt    DateTime?
  /// Why the mirror failed, kept so an unsynced report can be explained rather
  /// than silently looking like nobody cared.
  githubError       String?

  // The owner's list reads newest-first; the reporter's own list filters by them.
  @@index([createdAt])
  @@index([reporterId])
}

/// A personal credential for the MCP server.
///
/// Replaces one shared bearer token that made every MCP write look like the
/// owner's and could not be revoked for one person without breaking everybody.
/// The same key both authenticates to the MCP endpoint and says who is calling,
/// so recipes added through an assistant are attributed correctly and the
/// contribution gate applies per person.
///
/// Only a HASH is stored. The token is shown once, at creation; there is no route
/// that returns it again, because a database that can hand back live credentials
/// is a database whose backup is a set of live credentials.
model McpApiKey {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token. Unique so a presented key is one indexed lookup.
  tokenHash String    @unique
  /// The leading characters, for telling two keys apart in a list. Not a secret.
  prefix    String
  /// Whose laptop this is, in the user's own words.
  label     String
  createdAt DateTime  @default(now())
  /// Helps someone recognise a key they have forgotten about.
  lastUsedAt DateTime?
  /// Set rather than deleted, so a revoked key stays visible as revoked.
  revokedAt DateTime?

  @@index([userId])
}

/// One push endpoint — one browser on one device.
///
/// Keyed on `endpoint`, because that is the identifier the push service issues
/// and the only thing that identifies a device to us. The browser silently
/// rotates it, so the write path upserts: keying on userId instead would either
/// collapse a phone and a laptop into one row or accumulate dead endpoints that
/// fail forever.
///
/// Cascade on delete, unlike Recipe. A subscription is disposable plumbing, not
/// content — losing it costs the user one re-grant of permission.
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  /// The two halves of the client's ECDH keypair, as handed over by the browser.
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

/// A cooking timer that must ring even when the app is gone.
///
/// Exists because the in-page countdown cannot survive a locked phone: the tab
/// is discarded, nothing ticks, and the alarm never fires. The row is the
/// promise, and the backend keeps it whether or not any client is alive.
///
/// `fireAt` is computed server-side from a duration in seconds rather than
/// accepted as an instant, so a phone with a skewed clock still rings on time.
model ScheduledTimer {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Notification text, already localised by the client that asked for it. The
  /// backend never translates these — it has no idea which language the person
  /// was reading the recipe in.
  title     String
  body      String
  fireAt    DateTime
  /// Set the moment the send is claimed, which is what stops the next poll from
  /// ringing the same timer twice. Non-null means "dealt with", not "delivered".
  firedAt   DateTime?
  createdAt DateTime @default(now())

  // The scheduler's only query: unfired timers that are due. Ordering the index
  // firedAt-first lets Postgres skip every already-rung row, which is all of
  // them after a week of cooking.
  @@index([firedAt, fireAt])
  @@index([userId])
}

/// A kitchen. The unit of sharing.
///
/// Items belong to the pantry, not to a person: when one member uses the last of
/// the flour it is gone for everyone, which is what a shared pantry means.
/// Per-person ownership would leave two flour rows and no answer to "have we got
/// flour?", and could not express one person belonging to two kitchens.
model Pantry {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation("PantryOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       PantryMember[]
  items         PantryItem[]
  staples       StaplesConfig?
  mealPlans     MealPlan[]
  shoppingLists ShoppingList[]
  recipes       Recipe[]

  @@index([ownerId])
}

/// Who may use a kitchen. Sharing is adding a row here.
model PantryMember {
  id       String   @id @default(uuid())
  pantryId String
  pantry   Pantry   @relation(fields: [pantryId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// owner | member. The owner may not leave while others remain — a pantry
  /// with no owner is a support problem.
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([pantryId, userId])
  @@index([userId])
}

model Recipe {
  id                String             @id @default(uuid())
  servings          Int
  /// DEPRECATED — superseded by RecipeStep.imageUrl. Copied, not dropped; see
  /// the note on RecipeTranslation.instructions.
  instructionImages String[]
  prepTime          Int
  cookTime          Int
  difficulty        Difficulty
  // Tags stay CANONICAL (untranslated) on the base row: they are matching facets,
  // not prose. The filter chips send these exact values and translate only their
  // display label. Moving them into translations would break filtering.
  tags              String[]
  imageUrl          String?
  /// A gallery-sized WebP of imageUrl, around 60 KB against the original's 2 MB.
  ///
  /// Null means "none yet" and the list falls back to the full image, which is
  /// what it did before thumbnails existed — so a failed or pending conversion
  /// degrades to slow rather than to broken.
  thumbnailUrl      String?
  // Which locale this recipe was authored in. Reads fall back to it when the
  // requested locale has no translation, so text is never blank.
  sourceLocale      String             @default("en")
  /// Who added this recipe. Attribution first, and — since private recipes —
  /// also the one person who can always read it back, whatever happens to the
  /// kitchen below. Restrict, never Cascade: deleting a person must not delete
  /// the family's cookbook.
  createdById       String
  createdBy         User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  /// False means the shared library, which is what a recipe is by default and
  /// what every recipe was before this column existed. True narrows it to the
  /// members of `pantry` (plus the author, always).
  isPrivate         Boolean            @default(false)
  /// Which kitchen a private recipe belongs to, captured when it was written.
  ///
  /// A person can be in two kitchens, so "the author's household" is not a
  /// question the data could answer without naming one. SetNull, not Cascade:
  /// deleting a kitchen must not delete recipes, and a private recipe left
  /// without one falls back to author-only — never to public.
  pantryId          String?
  pantry            Pantry?            @relation(fields: [pantryId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ingredients       RecipeIngredient[]
  mealEntries       MealPlanEntry[]
  translations      RecipeTranslation[]
  steps             RecipeStep[]

  // The recipe list filters on difficulty and the two times, and orders by
  // createdAt. These are the columns the WHERE and ORDER BY now touch.
  @@index([difficulty])
  @@index([createdAt])
  @@index([createdById])
  // Every read now carries a visibility clause. The common shape is
  // "isPrivate = false", so lead with it; pantryId covers the member arm.
  @@index([isPrivate])
  @@index([pantryId])
}

// All localised recipe prose lives here, including the source locale — there is no
// second copy on Recipe to drift out of sync.
model RecipeTranslation {
  id          String @id @default(uuid())
  locale      String
  name        String
  description String
  /// DEPRECATED — superseded by RecipeStep/RecipeStepTranslation, which give a
  /// step an id so a variation can override one.
  ///
  /// Copied, not dropped, and no longer read or written. Dropping it in the same
  /// migration that copies it would leave no way back if the copy were wrong,
  /// and this project has destroyed Danish recipe text once already. It goes
  /// once the new tables are verified on production.
  instructions String[]
  recipeId     String
  recipe       Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, locale])
  @@index([locale])
}

/// One step of a method, with an identity.
///
/// Was `RecipeTranslation.instructions[]` — an array per locale — with
/// `Recipe.instructionImages[]` coupled to it BY POSITION, across two tables.
/// Nothing could refer to "this step", so a variation could only patch by index,
/// and index addressing has already cost this project two bugs.
///
/// The step itself is locale-independent: its position and its photograph are
/// the same in every language. Only the text translates.
model RecipeStep {
  id        String  @id @default(uuid())
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  sortOrder Int
  /// Was instructionImages[sortOrder]. Null where a recipe has fewer photographs
  /// than steps, which is the ordinary case rather than an error.
  imageUrl     String?
  translations RecipeStepTranslation[]

  @@unique([recipeId, sortOrder])
  @@index([recipeId])
}

model RecipeStepTranslation {
  id     String     @id @default(uuid())
  stepId String
  step   RecipeStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  locale String
  text   String

  @@unique([stepId, locale])
  @@index([locale])
}

model RecipeIngredient {
  id             String         @id @default(uuid())
  // Author-defined position within the recipe. Ingredient order is meaningful —
  // it tracks the method and groups sub-preparations — and ordering by `id`
  // (a random uuid) shuffles it. ShoppingListItem carries one for the same reason.
  sortOrder      Int            @default(0)
  quantity       Float
  unit           Unit
  pantryCategory PantryCategory
  recipeId       String
  recipe         Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  translations   RecipeIngredientTranslation[]

  // Serves both the join by recipeId and the ordered read, since a composite
  // index also answers lookups on its leading column. Declared here because it
  // existed only in the 20260728110000 migration — schema drift that the next
  // `prisma migrate dev` would have silently tried to drop.
  @@index([recipeId, sortOrder])
}

model RecipeIngredientTranslation {
  id           String           @id @default(uuid())
  locale       String
  name         String
  ingredientId String
  ingredient   RecipeIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, locale])
  @@index([locale])
}

model PantryItem {
  id           String         @id @default(uuid())
  pantryId     String
  pantry       Pantry         @relation(fields: [pantryId], references: [id], onDelete: Cascade)
  quantity     Float
  unit         Unit
  category     PantryCategory
  barcode      String?
  expiryDate   DateTime?
  sourceLocale String         @default("en")
  addedDate    DateTime       @default(now())
  lastUpdated  DateTime       @updatedAt
  translations PantryItemTranslation[]

  @@index([pantryId])
}

model PantryItemTranslation {
  id           String     @id @default(uuid())
  locale       String
  name         String
  pantryItemId String
  pantryItem   PantryItem @relation(fields: [pantryItemId], references: [id], onDelete: Cascade)

  @@unique([pantryItemId, locale])
  @@index([locale])
}

model MealPlan {
  id            String          @id @default(uuid())
  pantryId      String
  pantry        Pantry          @relation(fields: [pantryId], references: [id], onDelete: Cascade)
  /// Unique PER PANTRY, not globally. A global unique meant the second
  /// household could not plan a week the first had already planned.
  weekStartDate String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  entries       MealPlanEntry[]

  @@unique([pantryId, weekStartDate])
  @@index([pantryId])
}

model MealPlanEntry {
  id         String    @id @default(uuid())
  day        DayOfWeek
  meal       MealType
  servings   Int
  recipeId   String
  recipe     Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  mealPlanId String
  mealPlan   MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([mealPlanId])
  // Also serves the cascade delete when a recipe is removed.
  @@index([recipeId])
}

model ShoppingList {
  id            String             @id @default(uuid())
  pantryId      String
  pantry        Pantry             @relation(fields: [pantryId], references: [id], onDelete: Cascade)
  mealPlanId    String
  generatedDate DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  /// Set when the list is done with. NULL is the current list — which is the
  /// right meaning for every row that predates this column, since each was a
  /// live list at the time and none of them was ever archived.
  archivedAt    DateTime?
  items         ShoppingListItem[]

  @@index([pantryId])
  /// The current-list lookup is "newest unarchived for this kitchen".
  @@index([pantryId, archivedAt])
}

model ShoppingListItem {
  id             String       @id @default(uuid())
  name           String
  quantity       Float
  unit           Unit
  checked        Boolean      @default(false)
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)

  @@index([shoppingListId])
}

/// One per pantry. Was a single global row keyed "default".
model StaplesConfig {
  id       String   @id @default(uuid())
  pantryId String   @unique
  pantry   Pantry   @relation(fields: [pantryId], references: [id], onDelete: Cascade)
  items    String[]
}
